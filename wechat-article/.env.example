# 环境变量配置
# 复制此文件为 .env 并填入真实凭证：
#   cp .env.example .env

# 火山引擎 ARK API Key（即梦/豆包 Seedream 4.0）
# 获取方式：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=your-ark-api-key-here

# 微信公众平台 AppID 和 AppSecret
# 获取方式：https://mp.weixin.qq.com → 开发 → 基本配置
WECHAT_APPID=your-wechat-appid-here
WECHAT_SECRET=your-wechat-appsecret-here

# 默认作者名（可留空，每次运行时询问）
WECHAT_AUTHOR=
